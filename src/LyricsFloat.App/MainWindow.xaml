<Window x:Class="LyricsFloat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsFloat.App"
        Title="Floatify"
        Width="560" Height="256" MinWidth="340" MinHeight="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        MouseWheel="OnLyricsWheel">

    <!-- Borderless but resizable from every edge. Corners are rounded by Windows 11 (DWM), which also
         clips the frosted blur; the card uses the same 8 px radius so the two edges coincide. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Apple dark-mode palette: label colours are white at decreasing opacity -->
        <SolidColorBrush x:Key="Label" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryLabel" Color="#99EBEBF5" />
        <SolidColorBrush x:Key="Separator" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="SystemPink" Color="#FF375F" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="TextFont">SF Pro Text, Segoe UI Variable Text, Segoe UI</FontFamily>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F22C2C2E" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="9,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Lyric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Round icon button: a soft circle fades in on hover, springs back after a press -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="#00FFFFFF" />
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Press" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color"
                                                            To="#24FFFFFF" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color"
                                                            To="#00FFFFFF" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                             To="0.85" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                             To="0.85" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider in the macOS style: thin track, white fill, round white knob -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppleSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2" Background="#3DFFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style switch: grey track, turns green and slides the knob when on -->
        <Style x:Key="AppleSwitch" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#4D787880">
                            <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34C759" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer media buttons: drawn icons take their colour from the button's Foreground -->
        <SolidColorBrush x:Key="ModeOff" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ModeOn" Color="#30D158" />
        <Style x:Key="MediaButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <!-- Capsule button with a hairline border and a text label -->
        <Style x:Key="CapsuleButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">

        <!-- Backdrop: the album art blown up into soft colour (decoded tiny, scaled up smoothly).
             Upscaling fades the image's own edges to transparent, so it is drawn larger than the
             card and those faded edges fall outside the clip. -->
        <!-- Fixed height (set from code, footer included) and anchored to the top, so opening the footer
             reveals more of it instead of rescaling it. -->
        <Image x:Name="ArtBackdrop" VerticalAlignment="Top" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
            </Image.RenderTransform>
        </Image>

        <!-- Liquid glass: frosted desktop blur (enabled from code) under a dark tint that the
             transparency setting thins out, with light playing across the surface -->
        <Border CornerRadius="8">
            <Border.Background>
                <SolidColorBrush x:Name="MaterialBrush" Color="#121214" Opacity="0.6" />
            </Border.Background>
        </Border>
        <Border CornerRadius="8" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#0DFFFFFF" Offset="0.38" />
                    <GradientStop Color="#05FFFFFF" Offset="0.7" />
                    <GradientStop Color="#14FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>


        <!-- Card content: header and lyrics, with equal padding all round. Its height is pinned from code,
             so the window growing for the hover footer never resizes (and re-centres) the lyrics. -->
        <Grid x:Name="CardContent" Margin="16,14,16,14" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Lyrics: a scrolling list behind the header and scrubber. As many lines show as the window
                 height allows (at least three); they fade out towards the top and bottom edges. -->
            <!-- The fade lives on this wrapper, not on the clipped list inside: a mask on the list itself
                 would be sized to the whole (much taller) list rather than the visible area. -->
            <Border Grid.RowSpan="3" Margin="0,-14" Background="Transparent">
                <!-- A soft shadow keeps white lyrics legible over bright windows behind the glass.
                     It sits here, on the viewport-sized wrapper, so it is one cheap effect for all lines. -->
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                </Border.Effect>
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="Black" Offset="0.08" />
                        <GradientStop Color="Black" Offset="0.92" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            <Grid x:Name="LyricsArea" ClipToBounds="True" SizeChanged="OnLyricsAreaSizeChanged">

                <!-- A Canvas lets the list keep its full height; inside a Grid cell WPF would clip it to
                     the cell before it is scrolled into view. Its width is set from code. -->
                <Canvas>
                    <StackPanel x:Name="LinesPanel">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="LinesShift" />
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Canvas>

                <!-- Status messages (loading, not found, reconnecting) replace the list -->
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" Opacity="0">
                    <TextBlock x:Name="MessageText" Style="{StaticResource Lyric}" TextWrapping="Wrap" Opacity="0.75" />
                    <!-- Shown while a failed lookup waits to reconnect -->
                    <StackPanel x:Name="RetryPanel" Orientation="Horizontal" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="RetryText" FontFamily="{StaticResource TextFont}" FontSize="12"
                                   Foreground="{StaticResource SecondaryLabel}" VerticalAlignment="Center" />
                        <Button x:Name="RetryButton" Style="{StaticResource CapsuleButton}" Height="26" Margin="10,0,0,0"
                                FontSize="12" Click="OnRetryClick" ToolTip="Reconnect now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Try now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>

            <!-- A soft scrim keeps the header readable over the lyrics while hovered.
                 Several stops approximate an eased fade so there is no visible edge. -->
            <Border x:Name="TopScrim" Grid.Row="0" Margin="-16,-14,-16,-60" Opacity="0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3121214" Offset="0" />
                        <GradientStop Color="#94121214" Offset="0.2" />
                        <GradientStop Color="#66121214" Offset="0.42" />
                        <GradientStop Color="#38121214" Offset="0.62" />
                        <GradientStop Color="#14121214" Offset="0.82" />
                        <GradientStop Color="#00121214" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>


            <!-- Appears while browsing the lyrics with the mouse wheel; returns to the line being sung -->
            <Border x:Name="FollowPill" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12" Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FollowPillShift" />
                </Border.RenderTransform>
                <Button Click="OnFollowClick" Cursor="Hand" Focusable="False" ToolTip="Jump back to the line being sung">
                    <Button.Template>
                        <!-- White capsule, dark bold label with a waveform glyph; grows 10% on hover -->
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Height="44" CornerRadius="22" Background="White" Padding="24,0,26,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Grow" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.3" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Waveform: centred bars of varying height -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Rectangle Width="2.2" Height="8" RadiusX="1.1" RadiusY="1.1" Fill="#121212" Margin="0,0,2.6,0" />
                                        <Rectangle Width="2.2" Height="15" RadiusX="1.1" RadiusY="1.1" Fill="#121212" Margin="0,0,2.6,0" />
                                        <Rectangle Width="2.2" Height="22" RadiusX="1.1" RadiusY="1.1" Fill="#121212" Margin="0,0,2.6,0" />
                                        <Rectangle Width="2.2" Height="12" RadiusX="1.1" RadiusY="1.1" Fill="#121212" Margin="0,0,2.6,0" />
                                        <Rectangle Width="2.2" Height="18" RadiusX="1.1" RadiusY="1.1" Fill="#121212" Margin="0,0,2.6,0" />
                                        <Rectangle Width="2.2" Height="8" RadiusX="1.1" RadiusY="1.1" Fill="#121212" />
                                    </StackPanel>
                                    <TextBlock Text="Sync" FontFamily="{StaticResource TextFont}" FontSize="16" FontWeight="Bold"
                                               Foreground="#121212" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Header: artwork, title over artist, now-playing bars and controls. Like the scrubber it
                 only appears while the window is hovered; otherwise just the lyrics show. -->
            <!-- Dragging anywhere on the header (outside its buttons) moves the window -->
            <Grid x:Name="HeaderRow" Opacity="0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag"
                  MouseEnter="OnHeaderEnter" MouseLeave="OnHeaderLeave">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                    <Border CornerRadius="8" Background="#2C2C2E" />
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="14"
                               Foreground="{StaticResource SecondaryLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="8" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" Opacity="0" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Now-playing bars, as in Apple Music -->
                        <Grid x:Name="EqBars" Width="12" Height="10" Margin="0,0,6,1" VerticalAlignment="Center">
                            <Rectangle Width="2.4" HorizontalAlignment="Left" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource SystemPink}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Eq1" ScaleY="0.3" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.4" HorizontalAlignment="Center" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource SystemPink}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Eq2" ScaleY="0.3" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.4" HorizontalAlignment="Right" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource SystemPink}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Eq3" ScaleY="0.3" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="LockIndicator" Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                   Foreground="{StaticResource SecondaryLabel}" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="ArtistText" FontFamily="{StaticResource TextFont}" FontSize="12"
                               Foreground="{StaticResource SecondaryLabel}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel x:Name="Toolbar" Grid.Column="2" Orientation="Horizontal" Margin="8,0,-4,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Style="{StaticResource RoundButton}" Content="&#xE738;" Click="OnOffsetDown"
                            ToolTip="Later (Shift: 2s)" />
                    <Border VerticalAlignment="Center" CornerRadius="9" Background="#1FFFFFFF" Padding="7,2"
                            MouseRightButtonUp="OnOffsetReset"
                            ToolTip="Sync offset · right-click to reset"
                            ToolTipService.InitialShowDelay="120" ToolTipService.BetweenShowDelay="0">
                        <TextBlock x:Name="OffsetText" FontFamily="{StaticResource TextFont}" FontSize="11"
                                   FontWeight="SemiBold" MinWidth="32" TextAlignment="Center"
                                   Foreground="{StaticResource Label}" />
                    </Border>
                    <Button Style="{StaticResource RoundButton}" Content="&#xE710;" Click="OnOffsetUp"
                            ToolTip="Earlier (Shift: 2s)" />

                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource Separator}" />

                    <Button x:Name="SettingsButton" Style="{StaticResource RoundButton}" Content="&#xE713;"
                            Click="OnSettingsClick" ToolTip="Settings" />
                    <Button Style="{StaticResource RoundButton}" Content="&#xE72E;" Click="OnLockClick"
                            ToolTip="Lock · Ctrl+Alt+L" />
                    <Button Style="{StaticResource RoundButton}" Content="&#xE711;" Click="OnHideClick"
                            ToolTip="Hide · Ctrl+Alt+K" />
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Footer: playback controls over the scrubber, as in Spotify's player bar. On hover the window grows
             to reveal it as its own section below the lyrics (animated from code), instead of covering them. -->
        <Grid x:Name="ScrubberRow" Margin="16,0,16,0" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- Shuffle: green with a dot when on, dimmed when Spotify doesn't offer it -->
                <Button x:Name="ShuffleButton" Style="{StaticResource MediaButton}" Foreground="{StaticResource ModeOff}"
                        Click="OnShuffleClick" ToolTip="Shuffle">
                    <Grid Width="34" Height="34">
                        <Viewbox Width="16" Height="16">
                            <Path Width="16" Height="16" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M1,4 H3.5 C7,4 8.5,12 12,12 H14.5 M1,12 H3.5 C7,12 8.5,4 12,4 H14.5 M12.5,2 L14.8,4 L12.5,6 M12.5,10 L14.8,12 L12.5,14" />
                        </Viewbox>
                        <Ellipse x:Name="ShuffleDot" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                 Fill="{StaticResource ModeOn}" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="PrevButton" Style="{StaticResource MediaButton}" Click="OnPreviousClick" ToolTip="Previous track">
                    <Viewbox Width="14" Height="14">
                        <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M2.5,2 H5 V14 H2.5 Z M14.5,2 V14 L5.5,8 Z" />
                    </Viewbox>
                </Button>

                <Button x:Name="PlayButton" Click="OnPlayPauseClick" Margin="8,0" Cursor="Hand" Focusable="False"
                        ToolTipService.InitialShowDelay="120" ToolTipService.BetweenShowDelay="0"
                        ToolTip="Play / pause">
                    <Button.Template>
                        <!-- White disc with a solid black glyph; grows slightly on hover -->
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Disc" Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="DiscScale" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="White" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DiscScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="DiscScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DiscScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="DiscScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Disc" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid x:Name="PlayIcon" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PlayIconScale" />
                        </Grid.RenderTransform>
                        <Viewbox>
                            <Path x:Name="PauseGlyph" Width="16" Height="16" Fill="Black"
                                  Data="M3,2 H6.5 V14 H3 Z M9.5,2 H13 V14 H9.5 Z" />
                        </Viewbox>
                        <Viewbox>
                            <Path x:Name="PlayGlyph" Width="16" Height="16" Fill="Black" Visibility="Collapsed"
                                  Data="M4.5,2 L14,8 L4.5,14 Z" />
                        </Viewbox>
                    </Grid>
                </Button>

                <Button x:Name="NextButton" Style="{StaticResource MediaButton}" Click="OnNextClick" ToolTip="Next track">
                    <Viewbox Width="14" Height="14">
                        <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M11,2 H13.5 V14 H11 Z M1.5,2 V14 L10.5,8 Z" />
                    </Viewbox>
                </Button>

                <!-- Repeat: off, all (green + dot) or one (green + dot + "1"); dimmed when unavailable -->
                <Button x:Name="RepeatButton" Style="{StaticResource MediaButton}" Foreground="{StaticResource ModeOff}"
                        Click="OnRepeatClick" ToolTip="Repeat">
                    <Grid Width="34" Height="34">
                        <Viewbox Width="16" Height="16">
                            <Path Width="16" Height="16" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M2.5,8 V6.5 C2.5,5 3.5,4 5,4 H13.5 M11.5,1.8 L13.8,4 L11.5,6.2 M13.5,8 V9.5 C13.5,11 12.5,12 11,12 H2.5 M4.5,9.8 L2.2,12 L4.5,14.2" />
                        </Viewbox>
                        <TextBlock x:Name="RepeatOneBadge" Text="1" FontFamily="{StaticResource TextFont}" FontSize="7"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Visibility="Collapsed" />
                        <Ellipse x:Name="RepeatDot" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                 Fill="{StaticResource ModeOn}" Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" FontFamily="{StaticResource TextFont}" FontSize="10" FontWeight="Medium"
                       Foreground="{StaticResource SecondaryLabel}" MinWidth="30" VerticalAlignment="Center" />
            <!-- Scrubber: hover shows the time under the cursor; click or drag to seek -->
            <Grid x:Name="ScrubArea" Grid.Column="1" Margin="6,0" Background="Transparent"
                  MouseEnter="OnScrubEnter" MouseLeave="OnScrubLeave" MouseMove="OnScrubMove"
                  MouseLeftButtonDown="OnScrubPress" MouseLeftButtonUp="OnScrubRelease"
                  LostMouseCapture="OnScrubCaptureLost">
                <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center" ClipToBounds="True">
                    <Border x:Name="ScrubFill" CornerRadius="2" Background="#D9FFFFFF" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="ScrubThumb" Width="12" Height="12" Canvas.Top="1" Fill="White" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
            <TextBlock x:Name="RemainingText" Grid.Column="2" FontFamily="{StaticResource TextFont}" FontSize="10"
                       FontWeight="Medium" Foreground="{StaticResource SecondaryLabel}" MinWidth="30"
                       TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Time under the cursor while hovering the scrubber, floating just above it -->
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
                <Border x:Name="ScrubBubble" CornerRadius="6" Background="#F22C2C2E" BorderBrush="#26FFFFFF"
                        BorderThickness="1" Padding="7,3" Opacity="0">
                    <TextBlock x:Name="ScrubBubbleText" FontFamily="{StaticResource TextFont}" FontSize="12"
                               FontWeight="SemiBold" Foreground="White" />
                </Border>
            </Canvas>
        </Grid>

        <!-- First-run welcome card -->
        <Border x:Name="WelcomePanel" CornerRadius="8" Background="#E61C1C1E" Padding="20,16" Visibility="Collapsed"
                TextElement.Foreground="White" TextElement.FontFamily="{StaticResource TextFont}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Welcome to Floatify" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Synced lyrics for the Spotify desktop app, floating above your work."
                               FontSize="12" Foreground="{StaticResource SecondaryLabel}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,12,0,12">
                    <StackPanel TextElement.FontSize="12">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Play a song in Spotify" /> and its lyrics appear here. Floatify hides itself when nothing is playing.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Drag" /> to move it; drag an edge to resize. Click a line to jump there.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Hover the top" /> for playback controls and the ⚙ appearance settings.</TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Ctrl+Alt+L" /> locks it so clicks pass through · <Run FontWeight="SemiBold" Text="Ctrl+Alt+K" /> shows or hides it. The tray icon has everything else.</TextBlock>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="WelcomeStartupSwitch" Style="{StaticResource AppleSwitch}" IsChecked="True" />
                        <TextBlock Text="Start with Windows" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Height="30" Click="OnWelcomeDone" Cursor="Hand" Focusable="False"
                            FontSize="13" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="15" Background="White" Padding="16,0">
                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="#1C1C1E" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#E5E5EA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        Get started
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Appearance settings, opened from the gear button -->
        <Popup x:Name="SettingsPopup" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
               Closed="OnSettingsClosed" Opened="OnSettingsOpened"
               Placement="Bottom" PlacementTarget="{Binding ElementName=SettingsButton}" HorizontalOffset="-110"
               VerticalOffset="6">
            <Border Width="250" CornerRadius="14" Background="#F22C2C2E" BorderBrush="#26FFFFFF" BorderThickness="1"
                    Padding="16,12,16,14" TextElement.Foreground="White"
                    TextElement.FontFamily="{StaticResource TextFont}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Transparency" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="TransparencyText" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource SecondaryLabel}" />
                    </Grid>
                    <Slider x:Name="TransparencySlider" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="100"
                            ValueChanged="OnTransparencyChanged" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="Solid" FontSize="11" Foreground="{StaticResource SecondaryLabel}" />
                        <TextBlock Text="Clear" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{StaticResource SecondaryLabel}" />
                    </Grid>

                    <Grid Margin="0,14,0,6">
                        <TextBlock Text="Text size" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="TextSizeText" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource SecondaryLabel}" />
                    </Grid>
                    <Slider x:Name="TextSizeSlider" Style="{StaticResource AppleSlider}" Minimum="14" Maximum="48"
                            ValueChanged="OnTextSizeChanged" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="A" FontSize="10" Foreground="{StaticResource SecondaryLabel}" />
                        <TextBlock Text="A" FontSize="15" HorizontalAlignment="Right"
                                   Foreground="{StaticResource SecondaryLabel}" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource Separator}" Margin="0,14,0,12" />
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Hide when Spotify isn't playing" FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,48,0" />
                        <ToggleButton x:Name="AutoHideSwitch" Style="{StaticResource AppleSwitch}" HorizontalAlignment="Right"
                                      Checked="OnAutoHideSwitch" Unchecked="OnAutoHideSwitch" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Start with Windows" FontSize="12" VerticalAlignment="Center" />
                        <ToggleButton x:Name="StartupSwitch" Style="{StaticResource AppleSwitch}" HorizontalAlignment="Right"
                                      Checked="OnStartupSwitch" Unchecked="OnStartupSwitch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Shown while locked and hovered. A popup is its own window, so it stays clickable. -->
        <Popup x:Name="UnlockPopup" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True"
               Placement="Relative" PlacementTarget="{Binding ElementName=HeaderRow}">
            <Button Width="{x:Static local:MainWindow.UnlockPillWidth}"
                    Height="{x:Static local:MainWindow.UnlockPillHeight}" Click="OnUnlockClick"
                    Foreground="White" FontFamily="{StaticResource TextFont}" FontSize="12" FontWeight="SemiBold"
                    Cursor="Hand" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="#F22C2C2E" BorderThickness="1"
                                BorderBrush="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F23A3A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE785;" FontFamily="{StaticResource Icons}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="Unlock" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Popup>
    </Grid>
</Window>
